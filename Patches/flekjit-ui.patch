+//
+//  FlekJITReport.swift
+//  LiveContainerSwiftUI
+//
+//  A report on built-in JIT's setup, for a user to send to support when the
+//  check will not pass.
+//
+//  Why a check failed is often only said by the device itself — the disk
+//  image it would not mount, the session it closed — and a user's device
+//  cannot be connected to a computer to read its log. So the report is made by
+//  running the check again while the device's log is recorded, and holds what
+//  LiveContainer knows of the setup, each step of the check as it went, and the
+//  lines of the device's log from the services built-in JIT goes through.
+//
+//  It is a text file, shared from the share sheet, read by people.
+//
+
+import Foundation
+import Network
+import UIKit
+
+final class FlekJITReport: @unchecked Sendable {
+    private let lock = NSLock()
+    private let startedAt = Date()
+    private var steps: [String] = []
+    private var lastStage = -1
+    private var lastPercent = -1
+    private var deviceLog: LCDeviceLog?
+    private let vpn: String
+
+    /// - Parameter vpn: The VPN's state as the page knows it, which is read on
+    ///   the main actor.
+    init(vpn: String) {
+        self.vpn = vpn
+    }
+
+    // MARK: Recording
+
+    /// Starts recording the device's log, and waits until it is read or could
+    /// not be, so that the check is in it from its start. On the queue the
+    /// check runs on, after the VPN has been turned on for it.
+    func startDeviceLog() {
+        guard LCDeviceLog.isAvailable else {
+            note("Device log: not available in this build")
+            return
+        }
+        let log = LCDeviceLog(pairingFile: LCPath.pairingFilePath, keep: Self.isKept)
+        deviceLog = log
+        log.start()
+        if log.waitUntilRecording(withTimeout: 10) {
+            note("Device log: recording")
+        } else {
+            note("Device log: not recording — \(log.failure ?? "no answer within 10 s")")
+        }
+    }
+
+    /// A line for the steps, with how long into the check it came.
+    func note(_ line: String) {
+        let seconds = Date().timeIntervalSince(startedAt)
+        lock.lock()
+        steps.append(String(format: "+%6.2fs  %@", seconds, line))
+        lock.unlock()
+    }
+
+    /// The check's own progress, in StikJITPreflight's stages, noted when the
+    /// stage changes and every tenth of the way through a download or mount.
+    func noteStage(_ stage: Int, _ fraction: Double) {
+        let percent = fraction < 0 ? -1 : Int(fraction * 100)
+        lock.lock()
+        let isNew = stage != lastStage || (percent >= 0 && percent / 10 != lastPercent / 10)
+        if isNew {
+            lastStage = stage
+            lastPercent = percent
+        }
+        lock.unlock()
+        guard isNew else { return }
+        let name: String
+        switch stage {
+        case 0: name = "Connecting to the device"
+        case 1: name = "Checking the developer disk image"
+        case 2: name = "Downloading the developer disk image"
+        case 3: name = "Mounting the developer disk image"
+        case 4: name = "Verifying the mount"
+        case 5: name = "Ready"
+        default: name = "Stage \(stage)"
+        }
+        note(percent >= 0 ? "\(name) \(percent)%" : name)
+    }
+
+    /// Ends the recording, a moment after the check so that what the device
+    /// logged about its end is in, and writes the report. On the check's queue.
+    func finish(result: String) -> URL? {
+        note("Result: \(result)")
+        if let deviceLog {
+            Thread.sleep(forTimeInterval: 2)
+            deviceLog.stop()
+        }
+        let text = render(result: result)
+        let formatter = DateFormatter()
+        formatter.locale = Locale(identifier: "en_US_POSIX")
+        formatter.dateFormat = "yyyy-MM-dd HH.mm.ss"
+        let file = FileManager.default.temporaryDirectory
+            .appendingPathComponent("FlekJIT Report \(formatter.string(from: startedAt)).txt")
+        do {
+            try text.write(to: file, atomically: true, encoding: .utf8)
+            return file
+        } catch {
+            return nil
+        }
+    }
+
+    // MARK: Device log
+
+    /// The processes built-in JIT goes through: the device's pairing and
+    /// service directory, the disk image mounter and what it asks, the code
+    /// signing check, the debug server, the VPN, and LiveContainer itself. Lower
+    /// case.
+    private static let keptProcesses: Set<String> = [
+        "lockdownd", "remoted", "remotepairingd", "remotepairingdatavaultd",
+        "mobile_storage_proxy", "mobilestoragemounter", "storagekitd", "mobileactivationd",
+        "amfid", "debugserver", "installd",
+        "nesessionmanager", "neagent", "nehelper",
+        "loopbackvpn", ProcessInfo.processInfo.processName.lowercased(),
+    ]
+
+    /// Words that mark a line from elsewhere as being about the same things.
+    private static let keptWords = [
+        "developerdiskimage", "personaliz", "mobilestorage", "mobile_storage", "trustcache", "trust cache",
+        "amfi", "developer mode", "developermode", "debugserver", "remotepairing", "coredevice",
+    ]
+
+    /// A line of the relay reads "Nov 10 11:08:12 iPhone process(library)[pid]
+    /// <Level>: message", where the device's name may have spaces of its own,
+    /// so the sender is the first word ending in "[pid]". Kept if it is one of
+    /// the processes above, or speaks of what they do. The kernel is too busy
+    /// to keep whole.
+    static func isKept(_ line: String) -> Bool {
+        let header = line.split(separator: "<", maxSplits: 1).first ?? Substring(line)
+        if let sender = header.split(separator: " ").first(where: { $0.contains("[") && $0.hasSuffix("]") }) {
+            let name = sender.prefix { $0 != "[" && $0 != "(" }.lowercased()
+            if keptProcesses.contains(name) {
+                return true
+            }
+        }
+        let lowered = line.lowercased()
+        return keptWords.contains { lowered.contains($0) }
+    }
+
+    // MARK: Rendering
+
+    private func render(result: String) -> String {
+        var text = "FlekJIT Report\n"
+        text += String(repeating: "=", count: 14) + "\n\n"
+        text += setup().map { "\($0.0): \($0.1)" }.joined(separator: "\n")
+        text += "\n\nResult: \(result)\n"
+
+        lock.lock()
+        let steps = steps
+        lock.unlock()
+        text += "\nCheck\n-----\n" + steps.joined(separator: "\n") + "\n"
+
+        text += "\nDevice log\n----------\n"
+        if let deviceLog {
+            let lines = deviceLog.lines
+            if let failure = deviceLog.failure {
+                text += "(\(failure))\n"
+            }
+            text += lines.isEmpty ? "(no lines kept)\n" : lines.joined(separator: "\n") + "\n"
+        } else {
+            text += "(not recorded)\n"
+        }
+        return text
+    }
+
+    /// What LiveContainer knows of the device and the setup, as label and value.
+    private func setup() -> [(String, String)] {
+        let formatter = ISO8601DateFormatter()
+        formatter.formatOptions = [.withInternetDateTime]
+        formatter.timeZone = .current
+        let info = Bundle.main.infoDictionary ?? [:]
+        let version = "\(info["CFBundleShortVersionString"] as? String ?? "?") (\(info["CFBundleVersion"] as? String ?? "?"))"
+
+        var rows: [(String, String)] = [
+            ("Date", formatter.string(from: startedAt)),
+            ("LiveContainer", version),
+            ("Device", Self.modelIdentifier),
+            ("iOS", UIDevice.current.systemVersion),
+            ("Pairing file", Self.pairingFileSummary),
+            ("VPN", vpn),
+            ("Network", Self.networkSummary),
+        ]
+        rows.append(("Disk image cache", Self.diskImageSummary))
+        return rows
+    }
+
+    private static var modelIdentifier: String {
+        var system = utsname()
+        uname(&system)
+        return withUnsafeBytes(of: &system.machine) { bytes in
+            String(decoding: bytes.prefix { $0 != 0 }, as: UTF8.self)
+        }
+    }
+
+    private static var pairingFileSummary: String {
+        let url = LCPath.pairingFilePath
+        guard let attributes = try? FileManager.default.attributesOfItem(atPath: url.path) else {
+            return "none"
+        }
+        let size = (attributes[.size] as? NSNumber)?.intValue ?? 0
+        var parts = [FlekBuiltInJIT.isPairingFileMadeOnDevice ? "made on this device" : "imported", "\(size) bytes"]
+        if let date = attributes[.modificationDate] as? Date {
+            parts.append("saved \(ISO8601DateFormatter().string(from: date))")
+        }
+        if let data = try? Data(contentsOf: url),
+           let record = try? PropertyListSerialization.propertyList(from: data, format: nil) as? [String: Any] {
+            parts.append(FlekBuiltInJIT.isUsablePairingFile(record) ? "RemotePairing record" : "no RemotePairing record")
+            if record["HostID"] != nil {
+                parts.append("with lockdown record")
+            }
+        } else {
+            parts.append("unreadable")
+        }
+        return parts.joined(separator: ", ")
+    }
+
+    /// Which interface the traffic goes out on, and whether the device
+    /// answers through the VPN.
+    private static var networkSummary: String {
+        let semaphore = DispatchSemaphore(value: 0)
+        var summary = "unknown"
+        let monitor = NWPathMonitor()
+        monitor.pathUpdateHandler = { path in
+            var kinds: [String] = []
+            if path.usesInterfaceType(.wifi) { kinds.append("Wi-Fi") }
+            if path.usesInterfaceType(.cellular) { kinds.append("mobile data") }
+            if path.usesInterfaceType(.wiredEthernet) { kinds.append("wired") }
+            if path.usesInterfaceType(.other) { kinds.append("other (VPN)") }
+            summary = "\(path.status == .satisfied ? "online" : "offline")\(kinds.isEmpty ? "" : ", " + kinds.joined(separator: ", "))"
+            if path.isExpensive { summary += ", expensive" }
+            if path.isConstrained { summary += ", Low Data Mode" }
+            semaphore.signal()
+        }
+        let queue = DispatchQueue(label: "com.kdt.livecontainer.jitReport.path")
+        monitor.start(queue: queue)
+        _ = semaphore.wait(timeout: .now() + 1)
+        monitor.cancel()
+        return queue.sync { summary }
+    }
+
+    private static var diskImageSummary: String {
+        let folder = LCUtils.builtInJITFolder().appendingPathComponent("DMG")
+        guard let files = try? FileManager.default.subpathsOfDirectory(atPath: folder.path), !files.isEmpty else {
+            return "empty"
+        }
+        return files.sorted().compactMap { name -> String? in
+            var isDirectory: ObjCBool = false
+            let path = folder.appendingPathComponent(name).path
+            guard FileManager.default.fileExists(atPath: path, isDirectory: &isDirectory), !isDirectory.boolValue else {
+                return nil
+            }
+            let size = ((try? FileManager.default.attributesOfItem(atPath: path))?[.size] as? NSNumber)?.intValue ?? 0
+            return "\(name) (\(size) bytes)"
+        }.joined(separator: "; ")
+    }
+}
diff --git a/LiveContainerSwiftUI/FlekDeckJIT/FlekJITSetup.swift b/LiveContainerSwiftUI/FlekDeckJIT/FlekJITSetup.swift
new file mode 100644
index 0000000..a63bbbd
--- /dev/null
+++ b/LiveContainerSwiftUI/FlekDeckJIT/FlekJITSetup.swift
@@ -0,0 +1,385 @@
+//
+//  FlekJITSetup.swift
+//  LiveContainerSwiftUI
+//
+//  Whether JIT can be enabled as things stand, asked before an app set to
+//  launch with JIT is started. A guest enables JIT for itself as it launches,
+//  so one started without a working setup fails there, and all the user gets
+//  is an error the next time LiveContainer opens. Asked first, the same thing is a
+//  warning that says where JIT is set up, and the app is not started.
+//
+
+import Network
+import SwiftUI
+
+/// What built-in JIT needs that can be told without trying to enable it.
+enum FlekBuiltInJIT {
+    /// Why built-in JIT cannot work in this copy of LiveContainer whatever the user
+    /// sets up, or nil. Read once: none of it changes while the app runs.
+    static let blocker: String? = {
+#if targetEnvironment(simulator)
+        return "lc.flek.jit.blocker.simulator".loc
+#else
+        guard #available(iOS 17.4, *) else {
+            return "lc.flek.jit.blocker.os".loc
+        }
+        guard LCUtils.isBuiltInJITLoadable() else {
+            return "lc.flek.jit.blocker.unavailable".loc
+        }
+        // A debugger only attaches to a process signed with get-task-allow, and
+        // the signature is whatever this copy was last signed with. A guest
+        // runs in LiveProcess when in a window, in the app itself otherwise.
+        let liveProcess = Bundle.main.builtInPlugInsURL?.appendingPathComponent("LiveProcess.appex/LiveProcess").path
+        for executable in [Bundle.main.executablePath, liveProcess] {
+            if let executable, let entitlements = FlekSignature.entitlements(ofExecutableAt: executable),
+               entitlements["get-task-allow"] as? Bool != true {
+                return "lc.flek.jit.blocker.entitlement".loc
+            }
+        }
+        return nil
+#endif
+    }()
+
+    /// Starts a copy that has never had an enabler chosen on built-in JIT, the
+    /// one enabler that needs nothing outside LiveContainer. What it would start on
+    /// otherwise, upstream's default, wants a server on a computer, and its
+    /// address and a UDID are the first thing the JIT page then asks for.
+    /// A copy with such an address filled in is left as it is.
+    static func adoptWhereNothingIsChosen() {
+        let defaults = LCUtils.appGroupUserDefault
+        guard defaults.object(forKey: "LCJITEnablerType") == nil,
+              (defaults.string(forKey: "LCSideJITServerAddress") ?? "").isEmpty,
+              #available(iOS 17.4, *),
+              // By its file rather than by loading it, which this is too early for.
+              let frameworks = Bundle.main.privateFrameworksURL,
+              FileManager.default.fileExists(atPath: frameworks.appendingPathComponent("StikJITHeadless.framework/StikJITHeadless").path) else {
+            return
+        }
+        defaults.set(JITEnablerType.BuiltIn.rawValue, forKey: "LCJITEnablerType")
+    }
+
+    static var hasPairingFile: Bool {
+        (try? LCPath.pairingFilePath.checkResourceIsReachable()) ?? false
+    }
+
+    /// Whether a pairing file, read as a property list, holds a RemotePairing
+    /// record, which is the one StikJIT connects with. A pairing file made by
+    /// an older tool holds only a lockdown record.
+    static func isUsablePairingFile(_ file: [String: Any]) -> Bool {
+        file["public_key"] is Data && file["private_key"] is Data && file["identifier"] is String
+    }
+
+    /// Keeps `data` as the pairing file, if it is one built-in JIT can use.
+    /// One that is not would otherwise fail much later, at an app's launch,
+    /// with an error that says nothing about the file.
+    static func storePairingFile(_ data: Data) throws {
+        guard let file = try? PropertyListSerialization.propertyList(from: data, format: nil) as? [String: Any],
+              isUsablePairingFile(file) else {
+            throw "lc.flek.jit.pairingFile.wrongKind".loc
+        }
+        let destination = LCPath.pairingFilePath
+        try FileManager.default.createDirectory(at: destination.deletingLastPathComponent(),
+                                                withIntermediateDirectories: true)
+        try data.write(to: destination, options: .atomic)
+    }
+
+    /// What a pairing file made on this device carries besides its record.
+    static let madeOnDeviceKey = "created_on_device"
+
+    /// Whether the pairing file was made on this device rather than imported,
+    /// for saying which. The file says so itself: a note of it kept anywhere
+    /// else would be lost, or left behind, the moment the file is copied out
+    /// and imported again.
+    static var isPairingFileMadeOnDevice: Bool {
+        guard let data = try? Data(contentsOf: LCPath.pairingFilePath),
+              let record = try? PropertyListSerialization.propertyList(from: data, format: nil) as? [String: Any] else {
+            return false
+        }
+        return record[madeOnDeviceKey] as? Bool == true
+    }
+
+    /// Whether anything answers at the address a VPN gives this device, which
+    /// is the only way to tell that LocalDevVPN is connected: another app's VPN
+    /// cannot be asked about.
+    static func isDeviceReachable(within timeout: TimeInterval = 0.7) async -> Bool {
+        await withCheckedContinuation { continuation in
+            let connection = NWConnection(host: "10.7.0.1", port: 49152, using: .tcp)
+            let answer = OneAnswer<Bool> { isReachable in
+                connection.cancel()
+                continuation.resume(returning: isReachable)
+            }
+            connection.stateUpdateHandler = { state in
+                switch state {
+                case .ready: answer.give(true)
+                case .failed, .cancelled: answer.give(false)
+                default: break
+                }
+            }
+            let queue = DispatchQueue.global(qos: .userInitiated)
+            connection.start(queue: queue)
+            queue.asyncAfter(deadline: .now() + timeout) {
+                answer.give(false)
+            }
+        }
+    }
+
+    /// What the device is connected through, which decides whether JIT can be
+    /// started. iOS takes the connection built-in JIT makes through the VPN
+    /// while the device is on Wi-Fi or on nothing at all, as in Airplane Mode
+    /// or with Mobile Data switched off, and never while it is on mobile
+    /// data, which it takes the VPN to be part of. And a VPN cannot start on
+    /// nothing, though one that is on stays on. So away from Wi-Fi the order
+    /// is: the VPN on, then Airplane Mode on or Mobile Data off. Found on a
+    /// device with iOS 27, and what StikJIT's guide says of Airplane Mode.
+    enum Connection {
+        case wifi
+        case mobileData
+        /// No connection at all, as in Airplane Mode.
+        case offline
+    }
+
+    /// Asked only to explain a device that does not answer through the VPN.
+    /// Nil where it cannot be told.
+    static func connection() async -> Connection? {
+        await withCheckedContinuation { continuation in
+            let monitor = NWPathMonitor()
+            let answer = OneAnswer<Connection?> { connection in
+                monitor.cancel()
+                continuation.resume(returning: connection)
+            }
+            monitor.pathUpdateHandler = { path in
+                if path.usesInterfaceType(.wifi) || path.usesInterfaceType(.wiredEthernet) {
+                    answer.give(.wifi)
+                } else if path.usesInterfaceType(.cellular) {
+                    answer.give(.mobileData)
+                } else if path.status == .satisfied {
+                    answer.give(nil)
+                } else {
+                    answer.give(.offline)
+                }
+            }
+            let queue = DispatchQueue.global(qos: .userInitiated)
+            monitor.start(queue: queue)
+            queue.asyncAfter(deadline: .now() + 0.5) {
+                answer.give(nil)
+            }
+        }
+    }
+
+    /// Passes on the first answer it is given and drops the rest: the
+    /// connection and the timeout both give one.
+    private final class OneAnswer<Answer>: @unchecked Sendable {
+        private let lock = NSLock()
+        private var handler: ((Answer) -> Void)?
+
+        init(_ handler: @escaping (Answer) -> Void) {
+            self.handler = handler
+        }
+
+        func give(_ answer: Answer) {
+            lock.lock()
+            let handler = self.handler
+            self.handler = nil
+            lock.unlock()
+            handler?(answer)
+        }
+    }
+}
+
+enum FlekJITSetup {
+    /// JIT cannot be enabled as things stand, with what to tell the user.
+    struct NotReady: LocalizedError {
+        var title = "lc.flek.jit.notReady.title".loc
+        let message: String
+        /// What to say instead where the launch is kept and started once the
+        /// connection has changed, which is then all that is missing. Nil
+        /// where something else is.
+        var messageWhileWaiting: String?
+        /// The device is on mobile data with LiveContainer's own VPN on, so that
+        /// Mobile Data off is all that is missing, which the FlekJIT shortcut
+        /// can see to (FlekMobileDataShortcut).
+        var isOverMobileData = false
+        var errorDescription: String? { message }
+    }
+
+    /// Says when what the device is connected through has changed, for a
+    /// launch that waits on it: asked for Wi-Fi or Airplane Mode, the user
+    /// changes it in Control Center or in Settings, and the app is to start
+    /// when they have.
+    final class ConnectionWatch {
+        private let monitor = NWPathMonitor()
+        private let queue = DispatchQueue(label: "FlekJITSetup.ConnectionWatch")
+        private var hasSeenFirst = false
+
+        init(onChange: @escaping @MainActor () -> Void) {
+            monitor.pathUpdateHandler = { [weak self] _ in
+                guard let self else { return }
+                // The first is the connection as it is, not a change of it.
+                guard self.hasSeenFirst else {
+                    self.hasSeenFirst = true
+                    return
+                }
+                Task { @MainActor in onChange() }
+            }
+            monitor.start(queue: queue)
+        }
+
+        deinit {
+            monitor.cancel()
+        }
+    }
+
+    /// Where the setup stands, for showing it outside its own page.
+    enum Standing: Equatable {
+        case notStarted
+        /// Some of its three steps are done, this many.
+        case underWay(stepsDone: Int)
+        case ready
+        /// Set up, and Premium, which built-in JIT is used with, has ended.
+        case needsPremium
+        /// This copy cannot use built-in JIT, for the reason given.
+        case unavailable(String)
+        /// Another enabler is chosen, named here. Whether that one is ready
+        /// cannot be told from LiveContainer.
+        case external(String)
+    }
+
+    /// The steps counted here are the built-in section's first three; the
+    /// fourth, choosing apps, is use rather than setup.
+    @MainActor
+    static var standing: Standing {
+        let shared = LCUtils.appGroupUserDefault
+        let enabler = JITEnablerType(rawValue: shared.integer(forKey: "LCJITEnablerType")) ?? .SideJITServer
+        switch enabler {
+        case .BuiltIn:
+            break
+        case .SideJITServer:
+            // What an older copy starts on, with nothing filled in.
+            let address = shared.string(forKey: "LCSideJITServerAddress") ?? ""
+            let udid = shared.string(forKey: "LCDeviceUDID") ?? ""
+            return address.isEmpty || udid.isEmpty ? .notStarted : .external(enabler.displayName)
+        default:
+            return .external(enabler.displayName)
+        }
+        // Another LiveContainer uses the primary one's setup, none of which it can
+        // see, so it says nothing of it.
+        guard DataManager.shared.model.multiLCStatus == 0 else {
+            return .notStarted
+        }
+        if let blocker = FlekBuiltInJIT.blocker {
+            return .unavailable(blocker)
+        }
+        let hasFile = FlekBuiltInJIT.hasPairingFile
+        // As the VPN's model last found it, which it notes for guests.
+        let hasVPN = shared.bool(forKey: "LCBuiltInVPNConfigured")
+        guard hasFile || hasVPN else {
+            return .notStarted
+        }
+        // Only of a setup there is: one never started is still the invitation
+        // to start, and what that takes is said where it is started.
+        // (Upstream FlekDeck returns .needsPremium without Premium; this port
+        // has no Premium, so the case is simply never produced.)
+        let steps = [
+            hasFile,
+            // Another app's VPN where LiveContainer has none, and not to be seen.
+            hasVPN || !FlekLoopbackVPN.isAvailable,
+            hasFile && UserDefaults.standard.double(forKey: "FlekJITReadyAt") > 0,
+        ]
+        let done = steps.filter { $0 }.count
+        return done == steps.count ? .ready : .underWay(stepsDone: done)
+    }
+
+    /// Throws `NotReady` where starting an app with JIT would only fail.
+    @MainActor
+    static func ensureReady() async throws {
+        // Installed with TrollStore, an app has JIT from the start, and no
+        // enabler is asked for it whatever is chosen here.
+        if access("\(Bundle.main.bundlePath)/../_TrollStore", F_OK) == 0 {
+            return
+        }
+        let defaults = LCUtils.appGroupUserDefault
+        guard let enabler = JITEnablerType(rawValue: defaults.integer(forKey: "LCJITEnablerType")) else {
+            return
+        }
+        switch enabler {
+        case .BuiltIn:
+            try await ensureBuiltInReady()
+        case .SideJITServer:
+            // What a fresh install is set to, with nothing filled in.
+            let address = defaults.string(forKey: "LCSideJITServerAddress") ?? ""
+            let udid = defaults.string(forKey: "LCDeviceUDID") ?? ""
+            if address.isEmpty || udid.isEmpty {
+                throw NotReady(message: "lc.flek.jit.notReady.setUp".loc)
+            }
+        default:
+            // Another app enables JIT, and whether it will cannot be told here.
+            return
+        }
+    }
+
+    @MainActor
+    private static func ensureBuiltInReady() async throws {
+        if let blocker = FlekBuiltInJIT.blocker {
+            throw NotReady(message: blocker)
+        }
+        // Ahead of the setup: without Premium there is none to send anyone to.
+        try await ensurePremium()
+        // Another LiveContainer uses the primary one's pairing file, which it
+        // cannot see.
+        if DataManager.shared.model.multiLCStatus == 0, !FlekBuiltInJIT.hasPairingFile {
+            throw NotReady(message: "lc.flek.jit.notReady.setUp".loc)
+        }
+        let vpn = FlekLoopbackVPN.shared
+        if FlekLoopbackVPN.isAvailable {
+            await vpn.refresh()
+            if vpn.isConfigured {
+                do {
+                    try await vpn.connect()
+                } catch {
+                    // On no connection at all a VPN cannot start, and needs
+                    // one for a moment.
+                    if await FlekBuiltInJIT.connection() == .offline {
+                        throw connectionNotReady("lc.flek.jit.notReady.offline")
+                    }
+                    throw NotReady(message: "lc.flek.jit.notReady.vpn".loc)
+                }
+                // With the VPN up the device still does not answer over mobile
+                // data, and a launch would end in the helper's timeout, which
+                // asks about the VPN. The VPN is left on, so that Airplane
+                // Mode is all that is still needed. Not answering for another
+                // reason is left to the launch, as it was.
+                if !(await FlekBuiltInJIT.isDeviceReachable()), await FlekBuiltInJIT.connection() == .mobileData {
+                    var notReady = connectionNotReady("lc.flek.jit.notReady.mobileData")
+                    notReady.isOverMobileData = true
+                    throw notReady
+                }
+                return
+            }
+        }
+        // No VPN of LiveContainer's own, which leaves LocalDevVPN.
+        if !(await FlekBuiltInJIT.isDeviceReachable()) {
+            if FlekLoopbackVPN.isAvailable {
+                throw NotReady(message: "lc.flek.jit.notReady.setUp".loc)
+            }
+            // Whether LocalDevVPN is connected cannot be told, so over mobile
+            // data both it and Airplane Mode are asked for, in their order.
+            if await FlekBuiltInJIT.connection() == .mobileData {
+                throw connectionNotReady("lc.flek.jit.notReady.mobileData.other")
+            }
+            throw NotReady(message: "lc.flek.jit.notReady.vpn".loc)
+        }
+    }
+
+    /// Not ready for what the device is connected through, which the user is
+    /// about to change: said one way where they are to try again, and another
+    /// where the app starts by itself once they have.
+    private static func connectionNotReady(_ key: String) -> NotReady {
+        NotReady(message: key.loc, messageWhileWaiting: "\(key).waiting".loc)
+    }
+
+    // Premium does not exist in this port; the gate the upstream fork kept
+    // here is gone by construction. The method stays so the call site reads
+    // the same as upstream's flow.
+    @MainActor
+    private static func ensurePremium() async throws {}
+}
diff --git a/LiveContainerSwiftUI/FlekDeckJIT/FlekMobileDataShortcut.swift b/LiveContainerSwiftUI/FlekDeckJIT/FlekMobileDataShortcut.swift
new file mode 100644
index 0000000..95a97b6
--- /dev/null
+++ b/LiveContainerSwiftUI/FlekDeckJIT/FlekMobileDataShortcut.swift
@@ -0,0 +1,493 @@
+//
+//  FlekMobileDataShortcut.swift
+//  LiveContainerSwiftUI
+//
+//  JIT cannot be started while the device is on mobile data, and can once
+//  Mobile Data is switched off, with the VPN left on: found on a device with
+//  iOS 27. LiveContainer turns its own VPN on, so away from Wi-Fi all that is
+//  missing is Mobile Data off for the moment JIT takes to come on. iOS lets no
+//  app switch that. The Shortcuts app can, so the user adds a shortcut,
+//  "FlekJIT", which LiveContainer runs: with "off" as an app set to launch with JIT
+//  is started over mobile data, and with "on" once JIT is on.
+//
+//  An app can run a shortcut only by opening the Shortcuts app, which comes to
+//  the front for a moment and hands back through a link of LiveContainer's own.
+//
+//  "On" is run by whatever is in front when JIT comes on: here where the app
+//  runs in a window, and by the launched app itself where it takes LiveContainer's
+//  place (LCTurnMobileDataBackOn in LCBootstrap). That Mobile Data is off is
+//  noted in the shared settings from before the shortcut runs, so that a
+//  launch that ends before JIT is on leaves it to be switched back on the next
+//  time LiveContainer opens.
+//
+
+import Darwin
+import SwiftUI
+import notify
+
+@MainActor
+final class FlekMobileDataShortcut: ObservableObject {
+    static let shared = FlekMobileDataShortcut()
+
+    /// The shortcut's name, which it is run by. The Shortcuts app names a
+    /// shortcut after the file it is added from, so this is that file's name
+    /// as well.
+    static let name = "FlekJIT"
+
+    /// Where the Shortcuts app opens straight at Add Shortcut, which it does
+    /// only for an iCloud link, and that lives only while the shortcut stays
+    /// in its owner's library. None is set, so the shortcut is added from
+    /// LiveContainer's own copy, through the share sheet. One set here has to be of
+    /// the same shortcut as that copy.
+    static let iCloudLink: URL? = nil
+
+    /// What the shortcut's link back to LiveContainer is addressed to.
+    static let linkHost = "jit-mobile-data"
+
+    /// Where it is noted that the user has been through adding the shortcut,
+    /// which the page's switch waits for.
+    nonisolated static let wasAddedKey = "FlekJITMobileDataShortcutAdded"
+
+    /// The words the shortcut goes by. Any other does nothing, which is how
+    /// it is tried out.
+    private enum Word {
+        static let off = "off"
+        static let on = "on"
+        static let nothing = "check"
+    }
+
+    private enum Key {
+        static let isOn = "FlekJITMobileDataShortcut"
+        /// When the shortcut switched Mobile Data off, until it is back on.
+        /// LCBootstrap reads it too.
+        static let switchedOff = "FlekJITMobileDataOff"
+    }
+
+    /// What the helper posts once it is done with its connection, JIT on or
+    /// not (StikJITHeadless).
+    private static let helperOver = "com.kdt.livecontainer.flekjit.over"
+
+    enum Outcome {
+        /// The shortcut ran to its end.
+        case done
+        /// It did not, or did not say: it is missing, was stopped, or the
+        /// user came back without it.
+        case failed
+    }
+
+    /// Whether there is anything to offer: LiveContainer has to have the VPN, to
+    /// turn it on ahead of Mobile Data going off, and the device mobile data.
+    static let isOffered = FlekLoopbackVPN.isAvailable && hasMobileData
+
+    /// An iPad without mobile data has no interface for it.
+    private static let hasMobileData: Bool = {
+        var list: UnsafeMutablePointer<ifaddrs>?
+        guard getifaddrs(&list) == 0 else { return true }
+        defer { freeifaddrs(list) }
+        var entry = list
+        while let interface = entry {
+            if String(cString: interface.pointee.ifa_name).hasPrefix("pdp_ip") {
+                return true
+            }
+            entry = interface.pointee.ifa_next
+        }
+        return false
+    }()
+
+    private nonisolated static var defaults: UserDefaults { LCUtils.appGroupUserDefault }
+
+    /// Whether launches use the shortcut.
+    @Published var isOn = FlekMobileDataShortcut.defaults.bool(forKey: Key.isOn) {
+        didSet {
+            Self.defaults.set(isOn, forKey: Key.isOn)
+        }
+    }
+
+    /// The run under way is answered through this.
+    private var waiting: ((Outcome) -> Void)?
+    /// Counts the runs, for telling a timer that belongs to an earlier one.
+    private var runCount = 0
+    /// LiveContainer has gone behind the Shortcuts app for the run under way.
+    private var hasLeft = false
+    /// Mobile Data is to go back on as soon as LiveContainer is in front.
+    private var turnsOnWhenActive = false
+
+    private init() {
+        let center = NotificationCenter.default
+        center.addObserver(forName: UIApplication.didEnterBackgroundNotification, object: nil, queue: .main) { [weak self] _ in
+            Task { @MainActor in
+                guard let self, self.waiting != nil else { return }
+                self.hasLeft = true
+            }
+        }
+        center.addObserver(forName: UIApplication.didBecomeActiveNotification, object: nil, queue: .main) { [weak self] _ in
+            Task { @MainActor in self?.cameToFront() }
+        }
+        // An app in a window has LiveContainer in front, and its helper says when
+        // it is done.
+        var token: Int32 = 0
+        notify_register_dispatch(Self.helperOver, &token, .main) { [weak self] _ in
+            Task { @MainActor in
+                // Once the app in the window has seen that Mobile Data is
+                // being seen to, and so says nothing of it itself.
+                try? await Task.sleep(nanoseconds: 500_000_000)
+                self?.turnMobileDataBackOn()
+            }
+        }
+    }
+
+    // MARK: Mobile Data
+
+    /// Switches Mobile Data off for a launch. `completion` is called once
+    /// LiveContainer is back in front, and whether it worked shows in what the
+    /// device is then connected through rather than in what the shortcut said.
+    func turnMobileDataOff(completion: @escaping (Outcome) -> Void) {
+        // From before it runs: one that ends halfway may have switched it.
+        Self.defaults.set(Date().timeIntervalSince1970, forKey: Key.switchedOff)
+        run(Word.off, completion: completion)
+    }
+
+    /// Mobile Data turned out to be on still, so there is none to switch back.
+    func forget() {
+        Self.defaults.removeObject(forKey: Key.switchedOff)
+    }
+
+    /// Switches Mobile Data back on where the shortcut switched it off and it
+    /// has not been yet: JIT is on, or the launch it was for has come to
+    /// nothing. Asked once, so that a shortcut that has gone missing is not
+    /// asked for every time.
+    func turnMobileDataBackOn() {
+        guard Self.defaults.double(forKey: Key.switchedOff) > 0 else {
+            return
+        }
+        // Another app cannot be opened from behind.
+        guard UIApplication.shared.applicationState == .active else {
+            turnsOnWhenActive = true
+            return
+        }
+        forget()
+        run(Word.on) { _ in }
+    }
+
+    /// Runs the shortcut with nothing for it to do, which shows whether it is
+    /// there and finds its way back.
+    func tryOut(completion: @escaping (Outcome) -> Void) {
+        run(Word.nothing, completion: completion)
+    }
+
+    // MARK: Running
+
+    private func run(_ word: String, completion: @escaping (Outcome) -> Void) {
+        // One at a time: an earlier one is not answered by this one's link.
+        finish(.failed)
+        let back = "\(LCUtils.appUrlScheme() ?? "livecontainer")://\(Self.linkHost)"
+        var link = URLComponents()
+        link.scheme = "shortcuts"
+        link.host = "x-callback-url"
+        link.path = "/run-shortcut"
+        link.queryItems = [
+            URLQueryItem(name: "name", value: Self.name),
+            URLQueryItem(name: "input", value: "text"),
+            URLQueryItem(name: "text", value: word),
+            URLQueryItem(name: "x-success", value: "\(back)/success"),
+            URLQueryItem(name: "x-cancel", value: "\(back)/cancel"),
+            URLQueryItem(name: "x-error", value: "\(back)/error"),
+        ]
+        guard let url = link.url else {
+            completion(.failed)
+            return
+        }
+        runCount += 1
+        let run = runCount
+        waiting = completion
+        hasLeft = false
+        UIApplication.shared.open(url) { [weak self] opened in
+            guard !opened else { return }
+            Task { @MainActor in self?.finish(.failed, run: run) }
+        }
+        // A shortcut that waits on a question nobody answers.
+        finish(.failed, run: run, after: 60)
+    }
+
+    /// The shortcut's link back: `…://jit-mobile-data/success`, `/cancel` or
+    /// `/error`. False for any other link.
+    @discardableResult
+    func handle(_ url: URL) -> Bool {
+        guard url.host?.lowercased() == Self.linkHost else {
+            return false
+        }
+        finish(url.path == "/success" ? .done : .failed)
+        return true
+    }
+
+    private func cameToFront() {
+        if turnsOnWhenActive {
+            turnsOnWhenActive = false
+            turnMobileDataBackOn()
+        }
+        // Back from the Shortcuts app, and perhaps without its link: the user
+        // came back by hand, or it had nothing by that name to run. The link
+        // can follow LiveContainer to the front, so it is given a moment.
+        guard waiting != nil, hasLeft else {
+            return
+        }
+        hasLeft = false
+        finish(.failed, run: runCount, after: 2)
+    }
+
+    /// Answers the run numbered `run` in so many seconds, unless it has been
+    /// answered by then.
+    private func finish(_ outcome: Outcome, run: Int, after seconds: UInt64) {
+        Task { [weak self] in
+            try? await Task.sleep(nanoseconds: seconds * 1_000_000_000)
+            self?.finish(outcome, run: run)
+        }
+    }
+
+    /// Answers the run under way, or only the one numbered `run`.
+    private func finish(_ outcome: Outcome, run: Int? = nil) {
+        if let run, run != runCount {
+            return
+        }
+        guard let waiting else {
+            return
+        }
+        self.waiting = nil
+        hasLeft = false
+        waiting(outcome)
+    }
+
+    // MARK: Adding
+
+    /// LiveContainer's own copy of the shortcut, under the name it has to be added
+    /// by, for the share sheet to hand to the Shortcuts app. It is kept in the
+    /// asset catalog, which needs no place in the project of its own.
+    static func fileToAdd() -> URL? {
+        guard let shortcut = NSDataAsset(name: "FlekJITShortcut")?.data else {
+            return nil
+        }
+        let folder = FileManager.default.temporaryDirectory.appendingPathComponent("FlekJITShortcut", isDirectory: true)
+        let file = folder.appendingPathComponent("\(name).shortcut")
+        do {
+            try FileManager.default.createDirectory(at: folder, withIntermediateDirectories: true)
+            try shortcut.write(to: file, options: .atomic)
+        } catch {
+            return nil
+        }
+        return file
+    }
+}
+
+/// The row on the JIT page that the shortcut is added and turned on from, laid
+/// out as the setup's steps are and said to be optional: the setup is whole
+/// without it. Its (?) says what it is for and how it is set up, and so does
+/// Add, as the share sheet that adds it has to be told where to send it.
+struct FlekMobileDataShortcutRow: View {
+    @ObservedObject private var shortcut = FlekMobileDataShortcut.shared
+    /// The user has been through adding it. Whether it is there cannot be
+    /// asked, only tried, which turning it on does.
+    @AppStorage(FlekMobileDataShortcut.wasAddedKey) private var wasAdded = false
+    @State private var helpShown = false
+    /// While the shortcut is tried out, with the Shortcuts app in front.
+    @State private var isTrying = false
+    @State private var missingShown = false
+
+    var body: some View {
+        HStack(spacing: 12) {
+            Image(systemName: "antenna.radiowaves.left.and.right.circle")
+                .font(.title2)
+                .foregroundStyle(shortcut.isOn ? Color.green : Color.secondary)
+            VStack(alignment: .leading, spacing: 2) {
+                HStack(spacing: 6) {
+                    Text("lc.flek.jit.mobileData.title".loc)
+                    Button {
+                        helpShown = true
+                    } label: {
+                        Image(systemName: "questionmark.circle")
+                    }
+                    // A button of its own: the row has others.
+                    .buttonStyle(.borderless)
+                    .accessibilityLabel("lc.flek.jit.mobileData.help".loc)
+                }
+                Text("lc.flek.jit.mobileData.caption".loc)
+                    .font(.footnote)
+                    .foregroundStyle(.secondary)
+            }
+            Spacer(minLength: 8)
+            control
+                .alert("lc.flek.jit.mobileData.title".loc, isPresented: $missingShown) {
+                    Button("lc.flek.jit.mobileData.addAgain".loc) {
+                        // Once the alert has gone, which a sheet cannot come
+                        // up over.
+                        DispatchQueue.main.asyncAfter(deadline: .now() + 0.35) {
+                            startAdding()
+                        }
+                    }
+                    Button("lc.common.ok".loc, role: .cancel) {}
+                } message: {
+                    Text("lc.flek.jit.mobileData.missing".loc)
+                }
+        }
+        .padding(.vertical, 2)
+        .sheet(isPresented: $helpShown) {
+            FlekMobileDataShortcutHelpView()
+        }
+    }
+
+    @ViewBuilder
+    private var control: some View {
+        if isTrying {
+            ProgressView()
+        } else if wasAdded || shortcut.isOn {
+            Toggle("lc.flek.jit.mobileData.title".loc, isOn: isOn)
+                .labelsHidden()
+        } else {
+            Button("lc.flek.jit.mobileData.add".loc) {
+                startAdding()
+            }
+            .buttonStyle(.bordered)
+            .buttonBorderShape(.capsule)
+            .controlSize(.small)
+        }
+    }
+
+    /// Turned on only once the shortcut has run and come back, so that a
+    /// launch on the go does not find it missing.
+    private var isOn: Binding<Bool> {
+        Binding {
+            shortcut.isOn
+        } set: { isOn in
+            guard isOn else {
+                shortcut.isOn = false
+                return
+            }
+            isTrying = true
+            shortcut.tryOut { outcome in
+                isTrying = false
+                if outcome == .done {
+                    shortcut.isOn = true
+                } else {
+                    missingShown = true
+                }
+            }
+        }
+    }
+
+    /// From an iCloud link the Shortcuts app needs no telling what to do. From
+    /// the share sheet it is one of many places the file could go, so the
+    /// steps come first, with the button that adds it.
+    private func startAdding() {
+        if let link = FlekMobileDataShortcut.iCloudLink {
+            UIApplication.shared.open(link) { opened in
+                if opened {
+                    wasAdded = true
+                }
+            }
+        } else {
+            helpShown = true
+        }
+    }
+}
+
+/// What the shortcut is for and how it is set up: whether to bother with it is
+/// for whoever opens apps with JIT away from Wi-Fi to decide. Add Shortcut is
+/// the button that stands out, and the sheet goes once the shortcut has been
+/// handed on, leaving the switch on the page as what is left to do.
+struct FlekMobileDataShortcutHelpView: View {
+    private struct SharedFile: Identifiable {
+        let url: URL
+        var id: URL { url }
+    }
+
+    @Environment(\.dismiss) private var dismiss
+    @AppStorage(FlekMobileDataShortcut.wasAddedKey) private var wasAdded = false
+    @State private var sharedFile: SharedFile?
+
+    var body: some View {
+        NavigationView {
+            Form {
+                Section {
+                    Text("lc.flek.jit.mobileData.help.why".loc)
+                } header: {
+                    Text("lc.flek.jit.mobileData.help.whyHeader".loc)
+                } footer: {
+                    Text("lc.flek.jit.mobileData.help.who".loc)
+                }
+                Section {
+                    Label("lc.flek.jit.mobileData.help.step1".loc, systemImage: "1.circle")
+                    Label("lc.flek.jit.mobileData.help.step2".loc, systemImage: "2.circle")
+                    Label("lc.flek.jit.mobileData.help.step3".loc, systemImage: "3.circle")
+                } header: {
+                    Text("lc.flek.jit.mobileData.help.setUpHeader".loc)
+                }
+                Section {
+                    // Filled and the full width, with no row behind it, as the
+                    // computer guide's Refresh.
+                    Button(action: add) {
+                        Text("lc.flek.jit.mobileData.help.add".loc)
+                            .fontWeight(.semibold)
+                            .frame(maxWidth: .infinity)
+                    }
+                    .buttonStyle(.borderedProminent)
+                    .controlSize(.large)
+                    .listRowInsets(EdgeInsets())
+                    .listRowBackground(Color.clear)
+                } footer: {
+                    Text("lc.flek.jit.mobileData.help.note".loc)
+                }
+            }
+            .navigationTitle("lc.flek.jit.mobileData.title".loc)
+            .navigationBarTitleDisplayMode(.inline)
+            .toolbar {
+                ToolbarItem(placement: .confirmationAction) {
+                    Button("lc.common.done".loc) {
+                        dismiss()
+                    }
+                }
+            }
+        }
+        .sheet(item: $sharedFile) { file in
+            FlekShareSheet(items: [file.url]) { completed in
+                sharedFile = nil
+                guard completed else { return }
+                wasAdded = true
+                // Once the share sheet has gone: two going at once is refused.
+                DispatchQueue.main.asyncAfter(deadline: .now() + 0.35) {
+                    dismiss()
+                }
+            }
+        }
+    }
+
+    private func add() {
+        if let link = FlekMobileDataShortcut.iCloudLink {
+            UIApplication.shared.open(link) { opened in
+                guard opened else { return }
+                wasAdded = true
+                dismiss()
+            }
+            return
+        }
+        guard let file = FlekMobileDataShortcut.fileToAdd() else {
+            return
+        }
+        sharedFile = SharedFile(url: file)
+    }
+}
+
+/// The system's share sheet, saying whether anything was done with what it
+/// was given.
+private struct FlekShareSheet: UIViewControllerRepresentable {
+    let items: [Any]
+    let onDone: (Bool) -> Void
+
+    func makeUIViewController(context: Context) -> UIActivityViewController {
+        let sheet = UIActivityViewController(activityItems: items, applicationActivities: nil)
+        sheet.completionWithItemsHandler = { _, completed, _, _ in
+            onDone(completed)
+        }
+        return sheet
+    }
+
+    func updateUIViewController(_ sheet: UIActivityViewController, context: Context) {}
+}
diff --git a/LiveContainerSwiftUI/FlekDeckJIT/FlekPairingDownload.swift b/LiveContainerSwiftUI/FlekDeckJIT/FlekPairingDownload.swift
new file mode 100644
index 0000000..8e91e98
--- /dev/null
+++ b/LiveContainerSwiftUI/FlekDeckJIT/FlekPairingDownload.swift
@@ -0,0 +1,154 @@
+//
+//  FlekPairingDownload.swift
+//  LiveContainerSwiftUI
+//
+//  Collects the pairing file FlekPair sent for this device, so that a file
+//  made on a computer does not have to be carried over by hand.
+//
+//  FlekPair leaves what it exports on its server under the device's UDID,
+//  and the server hands it to whoever asks by that UDID. This app asks as
+//  the JIT page comes up, when the user is back from the computer, and when
+//  told to with Refresh.
+//
+
+import CryptoKit
+import Foundation
+
+enum FlekPairingDownload {
+    enum Failure: LocalizedError {
+        /// Which device to ask for is not known.
+        case unknownDevice
+        /// Nothing has been sent for this device.
+        case nothingSent
+        case unreachable
+        /// The server answered with an error other than having no file.
+        case refused(Int)
+        /// The server holds a file for this device with nothing in it.
+        case empty
+        /// The server answered with something that is no property list: a
+        /// network's sign-in page, say.
+        case notAFile
+        /// What was sent names another device.
+        case otherDevice
+        /// What was sent is no pairing file built-in JIT can use.
+        case unusable
+
+        var errorDescription: String? {
+            switch self {
+            case .unknownDevice: return "lc.flek.jit.pair.fetch.unknownDevice".loc
+            case .nothingSent: return "lc.flek.jit.pair.fetch.nothingSent".loc
+            case .unreachable: return "lc.flek.jit.pair.fetch.unreachable".loc
+            case .refused(let status): return String(format: "lc.flek.jit.pair.fetch.refused %lld".loc, status)
+            case .empty: return "lc.flek.jit.pair.fetch.empty".loc
+            case .notAFile: return "lc.flek.jit.pair.fetch.notAFile".loc
+            case .otherDevice: return "lc.flek.jit.pair.fetch.otherDevice".loc
+            case .unusable: return "lc.flek.jit.pairingFile.wrongKind".loc
+            }
+        }
+    }
+
+    /// Where FlekPair leaves the files, each under its device's UDID.
+    private static let server = "https://nestapi.flekstore.com/pairing-files"
+
+    /// What was taken last, by its digest.
+    private static let takenKey = "FlekPairingDownloadTaken"
+
+    /// A wait that ends: this runs behind a spinner, or with nothing shown.
+    private static let session: URLSession = {
+        let configuration = URLSessionConfiguration.ephemeral
+        configuration.timeoutIntervalForRequest = 15
+        configuration.timeoutIntervalForResource = 30
+        configuration.waitsForConnectivity = false
+        configuration.requestCachePolicy = .reloadIgnoringLocalCacheData
+        return URLSession(configuration: configuration)
+    }()
+
+    /// The pairing file waiting for this device, checked to be one built-in
+    /// JIT can use and to be this device's.
+    static func fetch() async throws -> Data {
+        let udid = try await deviceUDID()
+        // The server tells UDIDs apart by the case of their letters, and
+        // FlekPair files a pairing file under the UDID as the device spells
+        // it. That spelling is asked for first, and the one LiveContainer was told
+        // after it, where the two differ.
+        let spelled = udid.count == 40 ? udid.lowercased() : udid.uppercased()
+        var sent = try await sentFile(for: spelled)
+        if sent == nil, spelled != udid {
+            sent = try await sentFile(for: udid)
+        }
+        // The server answers the same for a device it has never heard of as
+        // for one nothing was sent for, and either way nothing was sent.
+        guard let body = sent else {
+            throw Failure.nothingSent
+        }
+        guard !body.isEmpty else {
+            throw Failure.empty
+        }
+
+        guard let file = try? PropertyListSerialization.propertyList(from: body, format: nil) as? [String: Any] else {
+            throw Failure.notAFile
+        }
+        // A pairing file FlekPair exports names its device. The server files
+        // whatever it is sent under whatever UDID it is sent with.
+        if let named = file["UDID"] as? String, named.caseInsensitiveCompare(udid) != .orderedSame {
+            throw Failure.otherDevice
+        }
+        guard FlekBuiltInJIT.isUsablePairingFile(file) else {
+            throw Failure.unusable
+        }
+        return body
+    }
+
+    /// What the server holds under a UDID, or nil where it holds nothing.
+    private static func sentFile(for udid: String) async throws -> Data? {
+        guard let address = URL(string: "\(server)/\(udid)") else {
+            throw Failure.unknownDevice
+        }
+        let body: Data
+        let response: URLResponse
+        do {
+            (body, response) = try await session.data(from: address)
+        } catch {
+            throw Failure.unreachable
+        }
+        guard let status = (response as? HTTPURLResponse)?.statusCode else {
+            throw Failure.unreachable
+        }
+        switch status {
+        case 200...299: return body
+        case 404: return nil
+        default: throw Failure.refused(status)
+        }
+    }
+
+    /// Whether `file` is what was taken last. The server keeps a file until
+    /// the next is sent, so one the user has since removed is still there, and
+    /// looking unasked must not bring it back.
+    static func wasTaken(_ file: Data) -> Bool {
+        UserDefaults.standard.string(forKey: takenKey) == digest(of: file)
+    }
+
+    static func noteTaken(_ file: Data) {
+        UserDefaults.standard.set(digest(of: file), forKey: takenKey)
+    }
+
+    private static func digest(of file: Data) -> String {
+        SHA256.hash(data: file).map { String(format: "%02x", $0) }.joined()
+    }
+
+    /// This device's UDID, which an app is told and cannot read: the
+    /// SideJITServer settings field keeps one once it has been filled in,
+    /// and the enabler's own launch writes what the helper reports. The
+    /// server-side UDID lookup the upstream fork had here is not part of
+    /// this port; without a stored UDID the fetch says unknownDevice and
+    /// the file importer remains the way.
+    private static func deviceUDID() async throws -> String {
+        let shared = LCUtils.appGroupUserDefault
+        for stored in [shared.string(forKey: "LCDeviceUDID")] {
+            if let udid = stored?.trimmingCharacters(in: .whitespacesAndNewlines), udid.isDeviceUDID {
+                return udid
+            }
+        }
+        throw Failure.unknownDevice
+    }
+}
