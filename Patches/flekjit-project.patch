+//
+//  StikJITHeadless.swift
+//  StikJITHeadless
+//
+//  Created by Duy Tran on 30/8/26.
+//
+
+import Foundation
+import StikJIT
+
+@objc(StikJITWrapper) public class StikJITWrapper: NSObject {
+    @objc public static func enableJIT(with pid: Int32, timeout: TimeInterval, pairingFile: URL, ddiPath: URL, scriptJs: String?) -> String {
+        let ddiPaths = DDIPaths.default(in: ddiPath)
+        var script = StikJIT.Script.universal
+        if let scriptJs {
+            // script can either be built-in (hardcoded) paths or base64 string
+            switch scriptJs {
+            case "/Frameworks/StikJIT.framework/universal.js", "":
+                // already specified universal as default
+                break
+            case "/Frameworks/StikJIT.framework/legacy.js":
+                script = StikJIT.Script.legacy
+                break
+            default:
+                script = StikJIT.Script.customBase64(scriptJs)
+            }
+        }
+        
+        do {
+            let config = StikJIT.Configuration(connectionTimeout: timeout)
+            try StikJIT.enableJIT(targetPID: pid, pairingFile: pairingFile, ddiPaths: ddiPaths,
+                                  configuration: config, script: script, forceScript: false, progress: { progress in
+                print(progress)
+            })
+            return ""
+        } catch {
+            return error.localizedDescription
+        }
+    }
+}
diff --git a/StikJITHeadless/StikJITPreflight.swift b/StikJITHeadless/StikJITPreflight.swift
new file mode 100644
index 0000000..ebf7437
--- /dev/null
+++ b/StikJITHeadless/StikJITPreflight.swift
@@ -0,0 +1,67 @@
+//
+//  StikJITPreflight.swift
+//  StikJITHeadless
+//
+
+import Foundation
+import StikJIT
+
+/// What Settings runs to tell whether built-in JIT can work right now. Nothing
+/// here attaches to a process, so unlike the JIT session itself it can run in
+/// the app rather than in a helper.
+@objc(StikJITPreflight) public class StikJITPreflight: NSObject {
+    // The codes of the errors `prepareDevice` returns. The app tells them apart
+    // by number, since it does not link this framework.
+    /// Nothing answered at the device's address.
+    private static let unreachableCode = 1
+    /// The device answered but is not ready.
+    private static let preparationFailedCode = 2
+
+    /// Nil once the device is reachable and its developer disk image is
+    /// mounted. `progress` gets a stage (0 reachability, 1 checking the image,
+    /// 2 downloading, 3 mounting, 4 verifying, 5 ready) and, where the stage
+    /// has one, how far along it is; otherwise a negative fraction.
+    @objc(prepareDeviceWithPairingFile:ddiPath:timeout:progress:)
+    public static func prepareDevice(pairingFile: URL, ddiPath: URL, timeout: TimeInterval,
+                                     progress: @escaping (Int, Double) -> Void) -> NSError? {
+        let config = StikJIT.Configuration(connectionTimeout: timeout)
+        let readiness = StikJIT.prepareDevice(pairingFile: pairingFile, paths: DDIPaths.default(in: ddiPath),
+                                              configuration: config) { stage in
+            switch stage {
+            case .checkingReachability: progress(0, -1)
+            case .checkingDDI: progress(1, -1)
+            case .downloadingDDI(let fraction, _): progress(2, fraction)
+            case .mountingDDI(let fraction): progress(3, fraction)
+            case .verifyingDDI: progress(4, -1)
+            case .ready: progress(5, 1)
+            @unknown default: break
+            }
+        }
+        switch readiness {
+        case .ready:
+            return nil
+        case .unreachable(let reason):
+            return error(code: unreachableCode, reason)
+        case .preparationFailed(let reason):
+            return error(code: preparationFailedCode, reason)
+        @unknown default:
+            return error(code: preparationFailedCode, "Unknown state")
+        }
+    }
+
+    /// Drops the cached developer disk image, so the next preparation downloads
+    /// it again.
+    @objc(resetCachedDDIAt:)
+    public static func resetCachedDDI(at ddiPath: URL) -> NSError? {
+        do {
+            try StikJIT.resetCachedDDI(at: DDIPaths.default(in: ddiPath))
+            return nil
+        } catch {
+            return self.error(code: preparationFailedCode, error.localizedDescription)
+        }
+    }
+
+    private static func error(code: Int, _ reason: String) -> NSError {
+        NSError(domain: "StikJIT", code: code, userInfo: [NSLocalizedDescriptionKey: reason])
+    }
+}
diff --git a/StikJITHeadless/main.m b/StikJITHeadless/main.m
new file mode 100644
index 0000000..d1a8077
--- /dev/null
+++ b/StikJITHeadless/main.m
@@ -0,0 +1,84 @@
+//
+//  main.m
+//  LiveContainer
+//
+//  Created by Duy Tran on 30/8/26.
+//
+@import Foundation;
+#import <CommonCrypto/CommonCrypto.h>
+#import <notify.h>
+#import "../LiveContainer/FoundationPrivate.h"
+#import "../LiveContainer/UIKitPrivate.h"
+#import "../LiveContainer/utils.h"
+
+@interface LiveProcessHandler : NSObject<NSExtensionRequestHandling>
++ (NSExtensionContext *)extensionContext;
++ (NSDictionary *)retrievedAppInfo;
+@end
+
+@interface StikJITWrapper : NSObject
++ (NSString *)enableJITWith:(int)pid timeout:(NSTimeInterval)timeout pairingFile:(NSURL *)pairing ddiPath:(NSURL *)ddi scriptJs:(NSString *)script;
+@end
+
+/// Tells LiveContainer that this is done with its connection, JIT on or not: with
+/// the app in a window, LiveContainer is what switches Mobile Data back on where
+/// its shortcut had switched it off for the launch.
+static void StikJITSayOver(void) {
+    notify_post("com.kdt.livecontainer.flekjit.over");
+}
+
+static int StikJITExitWithError(NSString *error) {
+    NSLog(@"Cancelling with error: %@", error);
+    StikJITSayOver();
+    NSExtensionContext *context = [NSClassFromString(@"LiveProcessHandler") extensionContext];
+    [context cancelRequestWithError:[NSError errorWithDomain:@"StikJIT" code:1 userInfo:@{NSLocalizedDescriptionKey: error}]];
+    return 1;
+}
+
+int StikJITHeadlessMain(void) {
+    NSError *e;
+    NSDictionary *appInfo = [NSClassFromString(@"LiveProcessHandler") retrievedAppInfo];
+    NSString *sandboxExtension = appInfo[@"sandboxExtension"];
+    NSArray *sandboxExtensionSplit = [sandboxExtension componentsSeparatedByString:@";"];
+    if (sandbox_extension_consume(sandboxExtension.UTF8String) < 1) {
+        return StikJITExitWithError(@"Failed in sandbox_extension_issue_file");
+    }
+    
+    NSString *path = sandboxExtensionSplit.lastObject;
+    NSURL *sandboxURL = [NSURL fileURLWithPath:path];
+    if (!sandboxURL) {
+        return StikJITExitWithError(e.localizedDescription);
+    }
+    
+    NSURL *pairingFile = [sandboxURL URLByAppendingPathComponent:@"ALTPairingFile.mobiledevicepairing"];
+    NSURL *ddiPath = [sandboxURL URLByAppendingPathComponent:@"DMG"];
+    if (![NSFileManager.defaultManager fileExistsAtPath:pairingFile.path]) {
+        return StikJITExitWithError(@"Pairing file is not set.");
+    }
+    
+    pid_t pid = [appInfo[@"pid"] unsignedIntValue];
+    NSString *scriptJs = appInfo[@"script"];
+    NSString *error = [StikJITWrapper enableJITWith:pid timeout:0.2 pairingFile:pairingFile ddiPath:ddiPath scriptJs:scriptJs];
+    // LiveContainer's own VPN is turned on as the guest launches and takes a moment
+    // to come up, during which the device does not answer.
+    for (int attempt = 0; attempt < 12 && [appInfo[@"waitForVPN"] boolValue] && [error containsString:@"Timed out connecting to"]; attempt++) {
+        error = [StikJITWrapper enableJITWith:pid timeout:0.5 pairingFile:pairingFile ddiPath:ddiPath scriptJs:scriptJs];
+    }
+    if (error.length < 1) {
+        // The debugger has let go of the app, which with TXM is some time
+        // after JIT came on: from here the app needs no connection, and says
+        // so where the user is waiting to switch one back on.
+        notify_post([NSString stringWithFormat:@"com.kdt.livecontainer.flekjit.done.%d", pid].UTF8String);
+        StikJITSayOver();
+        return 0;
+    }
+    if ([error containsString:@"Timed out connecting to"]) {
+        error = [error stringByAppendingString:@"\n\nIs the VPN connected, and this device on Wi-Fi or in Airplane Mode? Turn the VPN on in Settings, under JIT, or connect LocalDevVPN."];
+        // FIXME: auto open URL does not work
+        // NSString *callbackScheme = appInfo[@"callbackScheme"];
+        // LSApplicationWorkspace* workspace = [PrivClass(LSApplicationWorkspace) defaultWorkspace];
+        // [workspace openURL:[NSURL fileURLWithPath:[@"localdevvpn://enable?scheme=" stringByAppendingString:callbackScheme]]];
+        // error = [StikJITWrapper enableJITWith:pid timeout:4 pairingFile:pairingFile ddiPath:ddiPath scriptJs:scriptJs];
+    }
+    return StikJITExitWithError(error);
+}
